  "fixed_sql": [
    {
      "name": "jobs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"jobs\" (\"id\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"source_type\" TEXT NOT NULL, \"language\" TEXT NOT NULL, \"requested_length\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"failure_kind\" TEXT NULL, \"preview\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "job_transcripts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"job_transcripts\" (\"job_id\" TEXT NOT NULL REFERENCES jobs (id) ON DELETE CASCADE, \"content\" TEXT NOT NULL, \"word_count\" INTEGER NOT NULL CHECK(\"word_count\" >= 0), PRIMARY KEY (\"job_id\"));"
        }
      ]
    },
    {
      "name": "job_summaries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"job_summaries\" (\"job_id\" TEXT NOT NULL REFERENCES jobs (id) ON DELETE CASCADE, \"summary_text\" TEXT NOT NULL, \"takeaways\" TEXT NOT NULL, \"model_name\" TEXT NOT NULL, \"prompt_version\" TEXT NOT NULL, \"needs_review\" INTEGER NOT NULL DEFAULT 0 CHECK (\"needs_review\" IN (0, 1)), \"tokens_in\" INTEGER NULL, \"tokens_out\" INTEGER NULL, \"processing_time_ms\" INTEGER NULL, PRIMARY KEY (\"job_id\"));"
        }
      ]
    },
    {
      "name": "jobs_created_at_idx",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX jobs_created_at_idx ON jobs (created_at)"
        }
      ]
    },
